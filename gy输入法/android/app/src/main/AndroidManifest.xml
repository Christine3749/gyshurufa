<?xml version="1.0" encoding="utf-8"?>
<!--
  隐私红线（ANDROID-DESIGN.md §九）：v0.1/v0.2 不声明任何 <uses-permission>，
  包括 INTERNET。verify_identity.py 将"零权限声明"作为强制门禁。
  service 上的 android:permission="android.permission.BIND_INPUT_METHOD" 是
  IME 标准签名级守卫（由系统持有），不是面向用户的权限申请。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.GYInput">

        <activity
            android:name=".SetupActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".GyInputMethodService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

    </application>
</manifest>
