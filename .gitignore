**/native/runtime/
# The macOS app must ship a precompiled, offline Rime workspace. Keep the
# runtime tree ignored everywhere else, but allow this curated workspace to be
# versioned so a clean clone can build without relying on another worktree.
!gy输入法/native/runtime/
gy输入法/native/runtime/*
!gy输入法/native/runtime/rime/
gy输入法/native/runtime/rime/*
