#!/bin/bash
set -euo pipefail

app='/Library/Input Methods/GYInputPreview.app'
user="$(/usr/bin/stat -f '%Su' /dev/console)"
if [[ "$user" != root && "$user" != loginwindow && -x "$app/Contents/MacOS/GYInputPreview" ]]; then
  uid="$(/usr/bin/id -u "$user")"
  /bin/launchctl asuser "$uid" /usr/bin/pkill -x GYInputPreview || true
  /bin/launchctl asuser "$uid" "$app/Contents/MacOS/GYInputPreview" --register-input-source || true
fi
echo 'GY 输入法 2.0 Mac Preview 已更新。请从输入法菜单选择“GY 输入法 2.0 Preview”；它不会覆盖正式 GY。'
