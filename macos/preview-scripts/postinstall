#!/bin/bash
set -euo pipefail

target_root="${3%/}"
app="$target_root${2%/}/GYInputPreview.app"
[[ -x "$app/Contents/MacOS/GYInputPreview" ]] || app="$target_root/Library/Input Methods/GYInputPreview.app"
user="$(/usr/bin/stat -f '%Su' /dev/console)"

if [[ "$target_root" == '' && "$user" != root && "$user" != loginwindow ]]; then
  /usr/bin/sudo -u "$user" "$app/Contents/MacOS/GYInputPreview" --register-input-source
fi
echo 'GY 输入法 2.0 Mac Preview 已注册。请从输入法菜单选择“GY 输入法 2.0 Preview”；它不会覆盖正式 GY。'
