{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/ciku/:path*",
      "destination": "https://gy-shurufa-download.lihouyi7586.workers.dev/api/ciku/:path*"
    },
    {
      "source": "/api/releases/:path*",
      "destination": "https://gy-shurufa-download.lihouyi7586.workers.dev/api/releases/:path*"
    },
    {
      "source": "/api/releases/latest",
      "destination": "https://gy-shurufa-download.lihouyi7586.workers.dev/api/releases/latest"
    }
  ],
  "redirects": [
    {
      "source": "/windows/:path*",
      "destination": "https://download.shurufa.wang/windows/:path*",
      "permanent": false
    },
    {
      "source": "/download/:path*",
      "destination": "https://download.shurufa.wang/download/:path*",
      "permanent": false
    }
  ]
}
