{
  "name": "gy-shurufa-download",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-02",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "shurufa.wang/download/*",
      "zone_name": "shurufa.wang"
    },
    {
      "pattern": "www.shurufa.wang/download/*",
      "zone_name": "shurufa.wang"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RELEASES",
      "bucket_name": "gy-shurufa-releases"
    }
  ]
}
