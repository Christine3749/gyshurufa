{
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "gy-shurufa-macos-preview",
  "main": "src/index.js",
  "compatibility_date": "2026-08-04",
  "workers_dev": true,
  "routes": [
    { "pattern": "shurufa.wang/api/releases/macos/preview/*", "zone_name": "shurufa.wang" },
    { "pattern": "www.shurufa.wang/api/releases/macos/preview/*", "zone_name": "shurufa.wang" },
    { "pattern": "shurufa.wang/download/macos/preview/*", "zone_name": "shurufa.wang" },
    { "pattern": "www.shurufa.wang/download/macos/preview/*", "zone_name": "shurufa.wang" }
  ],
  "r2_buckets": [{ "binding": "RELEASES", "bucket_name": "gy-shurufa-releases" }]
}
